# EksporIn env vars. Copy to .env.local for local dev.
# Vercel populates these in production from its Environment Variables UI.

# Supabase Postgres (persistent storage for scraped buyer + shipment data).
# Supabase Dashboard, Settings, Database, Connection string, Transaction pooler.
# If your password contains a literal %, encode it as %25 here.
DATABASE_URL_POSTGRESS=postgresql://postgres.xxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Sumopod services (server-only, never expose to client).
SUMOPOD_PAY_KEY=
SUMOPOD_AI_KEY=

# UN Comtrade+ (primary key for aggregate trade data).
COMTRADE_KEY=

# Public base URL, used for redirect callbacks on payment gateway.
# Empty locally is fine; Vercel deploys inject their own URL.
PUBLIC_BASE_URL=
